{
  "name": "@local/dsh-projects-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex-style sidebar browser: a collapsible Projects category (workspaces with their sessions) and a Recent category listing every session by last activity.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
