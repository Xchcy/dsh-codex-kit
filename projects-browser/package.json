{
  "name": "@local/dsh-projects-browser",
  "version": "0.1.0",
  "description": "Codex-style sidebar browser for DeepSeek Harness: collapsible pinned/projects/recent sections, status marks (working, approval, interrupted, completed), right-click sort and workspace rename/delete, and per-session pin/archive menus.",
  "license": "MIT",
  "homepage": "https://github.com/Xchcy/dsh-codex-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xchcy/dsh-codex-kit.git",
    "directory": "projects-browser"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "codex",
    "sidebar"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
