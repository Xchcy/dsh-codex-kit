{
  "name": "@local/dsh-notifications-bell",
  "version": "0.1.0",
  "description": "Sidebar notification bell for DeepSeek Harness: a yellow dot for a conversation waiting for approval, red for an interrupted turn, blue for a completed one, with a status summary panel and a session board.",
  "license": "MIT",
  "homepage": "https://github.com/Xchcy/dsh-codex-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xchcy/dsh-codex-kit.git",
    "directory": "notifications-bell"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "codex",
    "sidebar"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
